punya_kupon_member = True
punya_kupon_flash_sale = True

# Model logika (XOR: pakai != karena Python tidak punya kata kunci 'xor')
dapat_potongan_ongkir = punya_kupon_member != punya_kupon_flash_sale

# Output hasil
if dapat_potongan_ongkir:
    print("Pembeli DAPAT potongan ongkir (kupon valid, hanya satu jenis)")
else:
    print("Pembeli TIDAK DAPAT potongan ongkir (kupon ganda tidak bisa digabung / tidak punya kupon)")
