punya_tiket_reguler = True
punya_tiket_promo = False

# Model logika (XOR: pakai != karena Python tidak punya kata kunci 'xor')
boleh_naik = punya_tiket_reguler != punya_tiket_promo

# Output hasil
if boleh_naik:
    print("Penumpang BOLEH naik (tiket valid, hanya satu jenis)")
else:
    print("Penumpang TIDAK BOLEH naik (tiket ganda / tidak punya tiket sama sekali)")
