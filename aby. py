aktif_organisasi = True
nilai_memenuhi = True
hadir_briefing = False
punya_laptop = True
punya_motor = False

# Model logika
lulus_seleksi = aktif_organisasi and nilai_memenuhi and hadir_briefing
perlengkapan_cukup = punya_laptop or punya_motor
divisi_khusus = punya_laptop != punya_motor

# Output hasil seleksi
if lulus_seleksi:
    print("Peserta LULUS seleksi panitia")
else:
    print("Peserta TIDAK LULUS seleksi panitia")

if perlengkapan_cukup:
    print("Peserta memiliki PERLENGKAPAN cukup")
else:
    print("Peserta tidak memiliki perlengkapan cukup")

if divisi_khusus:
    print("Peserta cocok untuk DIVISI KHUSUS")
else:
    print("Peserta tidak cocok untuk divisi khusus")
